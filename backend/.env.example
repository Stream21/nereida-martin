PORT=3000

# PostgreSQL en Docker WSL (persistente)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nere_studio

# URL pública (en Render se rellena automáticamente con RENDER_EXTERNAL_URL)
BACKEND_URL=https://nere-studio.onrender.com
FRONTEND_URL=https://nere-studio.onrender.com

# Google Calendar API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_WEB_EVENT_COLOR_ID=7

# Bloqueos manuales en Google Calendar — bloquean la web, no se importan a la BD
# Día completo: "[Bloqueo] Vacaciones" | Por horas: "[Bloqueo] Comida" 10:00-11:00
# GOOGLE_GHOST_EVENT_PREFIX=[Bloqueo]

# OAuth setup (optional — for remote authorization via tunnel)
# Default local callback: http://localhost:3333/oauth2callback (port 3333 avoids conflict with PORT=3000)
# GOOGLE_OAUTH_PORT=3333
# GOOGLE_OAUTH_REDIRECT_URI=https://YOUR-TUNNEL.trycloudflare.com/oauth2callback
#
# Remote flow (client authorizes from phone):
#   npm run google:auth:tunnel
#   → add printed redirect URI to Google Cloud → Clientes → redirect URIs
#   → send printed auth URL to client

# Primer día en que la web acepta reservas nuevas (YYYY-MM-DD)
BOOKING_START_DATE=2026-07-01

# Zona horaria del estudio (Canarias)
STUDIO_TIMEZONE=Atlantic/Canary

# Google Calendar push sync (HTTPS público requerido)
GOOGLE_WEBHOOK_URL=https://nere-studio.onrender.com/api/webhooks/google-calendar
GOOGLE_WEBHOOK_SECRET=

# Gmail SMTP (App Password: https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Owner notifications (defaults to GMAIL_USER)
OWNER_EMAIL=

# Panel privado /studio (usuario único, sin registro)
OWNER_DASHBOARD_EMAIL=
OWNER_DASHBOARD_PASSWORD_HASH=
JWT_SECRET=

# Owner action links (henna approve/reject) — use a long random string in production
OWNER_ACTION_SECRET=

# Google Calendar event colors (1–11)
GOOGLE_FIRST_VISIT_COLOR_ID=11
GOOGLE_FIRST_TREATMENT_COLOR_ID=5
GOOGLE_PENDING_COLOR_ID=4
GOOGLE_FLAGGED_COLOR_ID=11

# Cron security (Render puede generarlo automáticamente)
CRON_SECRET=
